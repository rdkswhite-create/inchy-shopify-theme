<section class="inchy-night inchy-night--editorial" aria-labelledby="InchyNight-{{ section.id }}">
  <div class="inchy-shell inchy-night__inner">
    <div>
      <p class="inchy-night__label">COMMON PROBLEM</p>
      <h2 class="inchy-night__heading" id="InchyNight-{{ section.id }}">THE HUNGER LOOP.</h2>
    </div>
    <div class="inchy-night__copy">
      <p class="inchy-night__time">10 PM — 11 PM</p>
      <p class="inchy-night__story">Dinner is over. You open the cupboard. One cookie. Then another. Before you know it, the package is empty.</p>
      <p class="inchy-night__story">Then comes the guilt. The next morning, you wake up regretting it.</p>
      <div class="inchy-night__approach">
        <p class="inchy-night__label">OUR APPROACH</p>
        <h3 class="inchy-night__heading">PUT SATIETY FIRST.</h3>
        <p>Satiety is the feeling of fullness that lasts after eating.</p>
        <p>INCHY is a sacha inchi nutraceutical focused on satiety, bringing protein and fiber together in a format you can add to everyday foods and drinks.</p>
        <a class="inchy-night__link" href="#what-is-inchy">EXPLORE THE APPROACH</a>
      </div>
    </div>
  </div>
</section>
{% style %}
  section.inchy-night--editorial { background: #080808; font-family: Inter, 'Helvetica Neue', Arial, sans-serif; }
  section.inchy-night--editorial .inchy-night__inner {
    display: block;
    width: 100%;
    max-width: 1024px;
    padding: clamp(80px, 12vw, 144px) 24px;
    box-sizing: border-box;
  }
  section.inchy-night--editorial .inchy-night__label,
  section.inchy-night--editorial .inchy-night__approach > .inchy-night__label {
    margin: 0 0 28px;
    color: #a3a3a3;
    font: 300 clamp(17px, 2vw, 22px)/1.8 Inter, 'Helvetica Neue', Arial, sans-serif;
    letter-spacing: .32em;
  }
  section.inchy-night--editorial .inchy-night__heading,
  section.inchy-night--editorial .inchy-night__approach h3 {
    margin: 0;
    color: #fff;
    font: 700 clamp(29px, 4.3vw, 52px)/1.15 Inter, 'Helvetica Neue', Arial, sans-serif;
    letter-spacing: -.035em;
    text-align: left;
  }
  section.inchy-night--editorial .inchy-night__copy { margin-top: 52px; }
  section.inchy-night--editorial .inchy-night__copy > .inchy-night__time {
    margin: 0 0 42px !important;
    color: #a3a3a3;
    font: 300 clamp(17px, 2vw, 22px)/1.8 Inter, 'Helvetica Neue', Arial, sans-serif;
    letter-spacing: .32em;
  }
  section.inchy-night--editorial .inchy-night__copy > .inchy-night__story,
  section.inchy-night--editorial .inchy-night__approach > p:not(.inchy-night__label) {
    margin: 0 0 32px;
    color: #c6c6c6;
    font: 300 clamp(17px, 2vw, 22px)/1.8 Inter, 'Helvetica Neue', Arial, sans-serif;
  }
  section.inchy-night--editorial .inchy-night__approach { margin-top: 56px; padding-top: 56px; border: 0; border-top: 1px solid #fff; }
  section.inchy-night--editorial .inchy-night__approach h3 { margin-bottom: 32px; }
  section.inchy-night--editorial .inchy-night__link {
    display: inline-block;
    margin-top: 0;
    padding: 10px 0;
    color: #fff;
    font: 500 13px/1.5 Inter, 'Helvetica Neue', Arial, sans-serif;
    letter-spacing: .22em;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 7px;
  }
{% endstyle %}
{% schema %}
{"name":"INCHY late-night moment","settings":[],"presets":[{"name":"INCHY late-night moment"}]}
{% endschema %}
