{% assign featured_product = section.settings.product %}
{% if featured_product == blank %}{% assign featured_product = settings.inchy_product %}{% endif %}
{% if featured_product == blank and collections.all.products_count == 1 %}{% assign featured_product = collections.all.products.first %}{% endif %}
<section class="inchy-shell" id="shop-inchy">
  <div class="inchy-product-panel">
    <div class="inchy-product-panel__image">
      {% render 'inchy-packaging' %}
    </div>
    <div class="inchy-product-panel__content">
      <h2>{% if featured_product != blank %}{% assign display_title = featured_product.title | split: '|' | first | strip %}{% render 'inchy-brand-text', text: display_title %}{% else %}{% render 'inchy-logo', inline: true %}{% endif %}</h2>
      <p>A sacha inchi nutraceutical focused on satiety.<br>Made for everyday use.</p>
      <p class="inchy-product-spec">PROTEIN + FIBRE<br>NO SWEETENERS. NO FLAVOURS. NO ADDITIVES.</p>
      {% if featured_product.metafields.custom.pack_size != blank or featured_product.metafields.custom.servings_per_pack != blank %}
        <dl class="inchy-facts inchy-purchase-facts">
          {% if featured_product.metafields.custom.pack_size != blank %}<div><dt>PACK SIZE</dt><dd>{{ featured_product.metafields.custom.pack_size | metafield_text }}</dd></div>{% endif %}
          {% if featured_product.metafields.custom.servings_per_pack != blank %}<div><dt>SERVINGS</dt><dd>{{ featured_product.metafields.custom.servings_per_pack | metafield_text }}</dd></div>{% endif %}
        </dl>
      {% endif %}

      {% if featured_product != blank %}
        <p class="inchy-price">{% if featured_product.price_varies %}From {% endif %}{{ featured_product.price_min | money }}</p>
        {% if featured_product.has_only_default_variant and featured_product.selling_plan_groups.size == 0 %}
        {% form 'product', featured_product, class: 'inchy-product-form' %}
          <input type="hidden" name="id" value="{{ featured_product.selected_or_first_available_variant.id }}">
          <button class="inchy-button inchy-button--wide" type="submit" {% unless featured_product.available %}disabled{% endunless %}>
            {% if featured_product.available %}ADD TO BAG{% else %}SOLD OUT{% endif %}
          </button>
        {% endform %}
        {% else %}
          <a class="inchy-button inchy-button--wide" href="{{ featured_product.url }}">CHOOSE OPTIONS</a>
        {% endif %}
        <a class="inchy-quiet-link" href="{{ featured_product.url }}">FULL PRODUCT DETAILS →</a>
      {% else %}
        {% if request.design_mode %}<p>Select the INCHY product in this section’s settings to enable purchasing.</p>{% endif %}
        <button class="inchy-button inchy-button--wide" type="button" disabled>COMING SOON</button>
      {% endif %}
      <a class="inchy-quiet-link" href="{{ routes.root_url }}?view=support">DELIVERY, RETURNS & CONTACT</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "INCHY product",
  "settings": [{ "type": "product", "id": "product", "label": "Featured product" }],
  "presets": [{ "name": "INCHY product" }]
}
{% endschema %}
