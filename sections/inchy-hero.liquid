<section class="inchy-shell inchy-hero inchy-hero--editorial" aria-labelledby="inchy-hero-title">
  {% capture hero_shop_url %}{% if section.settings.button_link != blank %}{{ section.settings.button_link }}{% else %}{% render 'inchy-shop-url' %}{% endif %}{% endcapture %}
  <div class="inchy-hero__opening">
    <div class="inchy-hero__identity">
      <h1 class="inchy-wordmark" id="inchy-hero-title">{% render 'inchy-logo' %}</h1>
      <p class="inchy-eyebrow" aria-label="Nonpharmaceutical satiety">
        <span>NONPHARMACEUTICAL</span>
        <span>SATIETY</span>
      </p>
    </div>
  </div>
  <div class="inchy-hero__packaging">
    <div class="inchy-hero__visual">{% render 'inchy-packaging', image_class: 'inchy-hero__product', loading: 'eager' %}</div>
    <a class="inchy-button" href="{{ hero_shop_url | strip | escape }}">{% if settings.inchy_prelaunch %}EXPLORE INCHY FORM1{% else %}{% render 'inchy-brand-text', text: section.settings.button_label %}{% endif %}</a>
    <div class="inchy-hero__copy">
      <p class="inchy-hero__format">FORM1 · UNFLAVOURED POWDER · MIX INTO FOOD OR DRINKS</p>
      {% if settings.inchy_prelaunch %}<a class="inchy-quiet-link" href="{{ routes.root_url }}?view=launch">NOTIFY ME AT LAUNCH</a>{% endif %}
    </div>
  </div>
</section>

{% style %}
  .inchy-hero--editorial .inchy-hero__opening {
    min-height: 0;
    align-items: flex-start;
    padding-block: clamp(30px, 5vw, 72px) 0;
  }
  .inchy-hero--editorial .inchy-hero__identity { text-align: left; }
  .inchy-hero--editorial .inchy-wordmark {
    width: 74%;
    max-width: 1060px;
    margin: 0;
  }
  .inchy-hero--editorial .inchy-hero__identity > .inchy-eyebrow {
    margin: clamp(24px, 5.8vw, 68px) 0 0;
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: clamp(8px, 2.1vw, 25px);
    font-weight: 300;
    letter-spacing: .42em;
    line-height: 1.3;
    color: #686868;
    white-space: nowrap;
  }
  .inchy-hero--editorial .inchy-hero__packaging {
    padding-block: clamp(105px, 25vw, 180px) 64px;
  }
  .inchy-hero--editorial .inchy-hero__visual {
    width: min(100%, 660px);
  }
  .inchy-hero--editorial .inchy-quiet-link { margin-inline: auto; }
  @media (max-width: 749px) {
    .inchy-shell.inchy-hero--editorial { width: calc(100% - 44px); }
    .inchy-hero--editorial .inchy-hero__visual { width: 100%; }
  }
{% endstyle %}

{% schema %}
{
  "name": "INCHY hero",
  "settings": [
    { "type": "paragraph", "content": "The reference pouch image is shared across all INCHY sections to keep the packaging consistent." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "SHOP INCHY" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "INCHY hero" }]
}
{% endschema %}
