<section class="inchy-shell inchy-hero" id="satiety">
  <div class="inchy-wordmark" aria-label="INCHY">inchy</div>

  {% if section.settings.image != blank %}
    {{ section.settings.image | image_url: width: 1100 | image_tag: class: 'inchy-hero__product', loading: 'eager', widths: '420, 640, 900, 1100', alt: 'INCHY sacha inchi nutraceutical pouch' }}
  {% else %}
    <img class="inchy-hero__product" src="{{ 'inchy-pouch.jpg' | asset_url }}" width="1254" height="1254" loading="eager" alt="INCHY sacha inchi nutraceutical pouch">
  {% endif %}

  <div class="inchy-hero__copy">
    <p class="inchy-eyebrow inchy-eyebrow--large">{{ section.settings.eyebrow }}</p>
    <p>{{ section.settings.body }}</p>
    <a class="inchy-button" href="{{ section.settings.button_link | default: '#shop-inchy' }}">{{ section.settings.button_label }}</a>
  </div>

  <ul class="inchy-stats" aria-label="Product highlights" role="list">
    <li>{{ section.settings.stat_1 }}</li>
    <li>{{ section.settings.stat_2 }}</li>
    <li>{{ section.settings.stat_3 }}</li>
    <li>{{ section.settings.stat_4 }}</li>
  </ul>

  <div class="inchy-era">
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.line_1 }}</p>
    <p><strong>{{ section.settings.line_2 }}</strong></p>
  </div>
</section>

{% schema %}
{
  "name": "INCHY hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Product image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "NONPHARMACEUTICAL SATIETY." },
    { "type": "textarea", "id": "body", "label": "Description", "default": "A sacha inchi nutraceutical focused on satiety. Made for everyday use." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "SHOP INCHY" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "stat_1", "label": "First statistic", "default": "120 KCAL / 30 G" },
    { "type": "text", "id": "stat_2", "label": "Second statistic", "default": "66% PROTEIN" },
    { "type": "text", "id": "stat_3", "label": "Third statistic", "default": "14% FIBRE" },
    { "type": "text", "id": "stat_4", "label": "Fourth statistic", "default": "0% ADDITIVES" },
    { "type": "text", "id": "heading", "label": "Story heading", "default": "SATIETY. GLP-1." },
    { "type": "text", "id": "line_1", "label": "Story line one", "default": "GLP-1 changed how we understand appetite." },
    { "type": "text", "id": "line_2", "label": "Story line two", "default": "INCHY was created for the satiety era." }
  ],
  "presets": [{ "name": "INCHY hero" }]
}
{% endschema %}
