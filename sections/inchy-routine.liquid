<section class="inchy-shell inchy-section inchy-chapter" id="how-to-use">
  <span class="inchy-chapter__number" aria-hidden="true">03</span>
  <div class="inchy-chapter__body">
  <header class="inchy-chapter-heading">
    <p class="inchy-kicker">THE ROUTINE</p><h2 class="inchy-section-title">MAKE IT PART OF YOUR DAY.</h2>
  </header>
  {% if section.settings.demonstration != blank %}
    <figure class="inchy-routine-demo">
      {{ section.settings.demonstration | video_tag: image_size: '1600x', controls: true, autoplay: false, loop: false, preload: 'metadata' }}
      {% if section.settings.video_caption != blank %}<figcaption>{{ section.settings.video_caption | escape }}</figcaption>{% endif %}
      {% if section.settings.video_transcript != blank %}<details class="inchy-disclosure"><summary>READ THE DEMONSTRATION</summary><div>{{ section.settings.video_transcript }}</div></details>{% endif %}
    </figure>
  {% else %}
  <div class="inchy-routine-grid">
    {% assign routine_image = section.settings.image %}
    {% for step in (1..3) %}
      {% capture routine_alt %}{% case step %}{% when 1 %}INCHY powder added to yogurt{% when 2 %}INCHY powder added to oats{% when 3 %}INCHY powder stirred into a drink{% endcase %}{% endcapture %}
      <figure class="inchy-routine-step inchy-routine-step--{{ step }}">
        {% if routine_image != blank %}
          {{ routine_image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '700, 1100, 1800', alt: routine_alt }}
        {% else %}
          <img src="{{ 'inchy-routine.jpg' | asset_url }}" width="1942" height="809" loading="lazy" alt="{{ routine_alt | escape }}">
        {% endif %}
        <figcaption>
          <span>0{{ step }}</span>
          {% case step %}{% when 1 %}IN YOGURT{% when 2 %}IN OATS{% when 3 %}IN A DRINK{% endcase %}
        </figcaption>
      </figure>
    {% endfor %}
  </div>
  {% endif %}
  <p class="inchy-routine-note">One nutraceutical. Different ways to use it.<br>Measure the serving stated on your pouch, add it to food or a drink, and mix thoroughly.</p>
  <a class="inchy-text-link" href="{{ routes.root_url }}?view=how-to-use">FIND YOUR ROUTINE →</a>
  </div>
</section>

{% schema %}
{
  "name": "INCHY routine",
  "settings": [
    { "type": "video", "id": "demonstration", "label": "Real preparation video", "info": "Select footage of the actual INCHY product. When selected, it replaces the three use images." },
    { "type": "text", "id": "video_caption", "label": "Video caption" },
    { "type": "richtext", "id": "video_transcript", "label": "Video description or transcript" },
    { "type": "image_picker", "id": "image", "label": "Routine image" }
  ],
  "presets": [{ "name": "INCHY routine" }]
}
{% endschema %}
