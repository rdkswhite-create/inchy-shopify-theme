<section class="inchy-shell inchy-section" id="how-to-use">
  <header class="inchy-section-heading">
    <div><p class="inchy-kicker">03 / THE ROUTINE</p><h2 class="inchy-section-title">MADE FOR YOUR EVERYDAY.</h2></div>
    <a class="inchy-text-link" href="{{ routes.root_url }}?view=how-to-use">HOW TO USE →</a>
  </header>
  <div class="inchy-routine-grid">
    {% assign routine_image = section.settings.image %}
    {% for step in (1..3) %}
      {% capture routine_alt %}{% case step %}{% when 1 %}INCHY powder added to yogurt{% when 2 %}INCHY powder added to oats{% when 3 %}INCHY powder stirred into a drink{% endcase %}{% endcapture %}
      <figure class="inchy-routine-step inchy-routine-step--{{ step }}">
        {% if routine_image != blank %}
          {{ routine_image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '700, 1100, 1800', alt: routine_alt }}
        {% else %}
          <img src="{{ 'inchy-routine.jpg' | asset_url }}" width="1942" height="809" loading="lazy" alt="{{ routine_alt | escape }}">
        {% endif %}
        <figcaption>
          <span>0{{ step }}</span>
          {% case step %}{% when 1 %}IN YOGURT{% when 2 %}IN OATS{% when 3 %}IN A DRINK{% endcase %}
        </figcaption>
      </figure>
    {% endfor %}
  </div>
  <p class="inchy-routine-note">One nutraceutical. Different ways to use it.<br>Measure the serving stated on your pouch, add it to food or a drink, and mix thoroughly.</p>
</section>

{% schema %}
{
  "name": "INCHY routine",
  "settings": [{ "type": "image_picker", "id": "image", "label": "Routine image" }],
  "presets": [{ "name": "INCHY routine" }]
}
{% endschema %}
