<section class="inchy-shell inchy-section" id="how-to-use">
  <header class="inchy-section-heading">
    <div><p class="inchy-kicker">03 / THE ROUTINE</p><h2>MADE FOR YOUR EVERYDAY.</h2></div>
    <a class="inchy-text-link" href="{{ routes.root_url }}?view=how-to-use">HOW TO USE →</a>
  </header>
  <div class="inchy-routine-grid">
    {% assign routine_image = section.settings.image %}
    {% for step in (1..3) %}
      <figure class="inchy-routine-step inchy-routine-step--{{ step }}">
        {% if routine_image != blank %}
          {{ routine_image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '700, 1100, 1800', alt: 'Ways to add INCHY to an everyday routine' }}
        {% else %}
          <img src="{{ 'inchy-routine.jpg' | asset_url }}" width="1942" height="809" loading="lazy" alt="Ways to add INCHY to an everyday routine">
        {% endif %}
        <figcaption>
          <span>0{{ step }}</span>
          {% case step %}{% when 1 %}MEASURE{% when 2 %}MIX{% when 3 %}MAKE IT A ROUTINE{% endcase %}
        </figcaption>
      </figure>
    {% endfor %}
  </div>
  <p class="inchy-routine-note">Add to food or a drink. Follow the serving directions on your pouch.</p>
</section>

{% schema %}
{
  "name": "INCHY routine",
  "settings": [{ "type": "image_picker", "id": "image", "label": "Routine image" }],
  "presets": [{ "name": "INCHY routine" }]
}
{% endschema %}
