<footer class="inchy-shell inchy-footer">
  <a class="inchy-brand" href="{{ routes.root_url }}" aria-label="INCHY home">{% render 'inchy-logo' %}</a>
  <nav aria-label="Footer navigation">
    <a href="{% render 'inchy-shop-url' %}">SHOP</a>
    <a href="{{ routes.root_url }}?view=research">RESEARCH</a>
    <a href="{{ routes.root_url }}#origin">ORIGIN</a>
    <a href="{{ routes.root_url }}?view=support">CONTACT & SUPPORT</a>
    {% for policy in shop.policies %}
      {% if policy != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}
    {% endfor %}
  </nav>
  <small>&copy; {{ 'now' | date: '%Y' }} {% render 'inchy-logo', inline: true %}</small>
</footer>
{% schema %}
{"name":"INCHY footer","settings":[],"enabled_on":{"groups":["footer"]}}
{% endschema %}
