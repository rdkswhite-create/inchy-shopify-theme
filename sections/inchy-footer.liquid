<footer class="inchy-shell inchy-footer">
  <a class="inchy-brand" href="{{ routes.root_url }}" aria-label="INCHY home">inchy</a>
  <nav aria-label="Footer navigation">
    <a href="{{ routes.root_url }}#shop-inchy">SHOP</a>
    <a href="{{ routes.root_url }}#research">RESEARCH</a>
    <a href="{{ routes.root_url }}#origin">ORIGIN</a>
    <a href="{{ routes.root_url }}#faq">SUPPORT</a>
    {% for policy in shop.policies %}
      {% if policy != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}
    {% endfor %}
  </nav>
  <small>&copy; {{ 'now' | date: '%Y' }} INCHY</small>
</footer>
{% schema %}
{"name":"INCHY footer","settings":[],"enabled_on":{"groups":["footer"]}}
{% endschema %}
