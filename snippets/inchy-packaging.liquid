{% comment %}Shared INCHY product packshot.{% endcomment %}
<img
  class="{{ image_class }}"
  src="{{ 'inchy-reference-pouch.jpg' | asset_url }}"
  width="928"
  height="1152"
  loading="{{ loading | default: 'lazy' }}"
  {% if loading == 'eager' %}fetchpriority="high"{% endif %}
  alt="INCHY sacha inchi pouch — white resealable packaging with black inchy wordmark"
>
