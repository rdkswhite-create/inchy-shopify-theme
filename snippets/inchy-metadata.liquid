{%- liquid
  assign site_name = shop.name
  if site_name == 'My Store' or site_name == blank
    assign site_name = 'inchy'
  endif
  assign title = page_title
  assign description = page_description
  assign page_url = canonical_url
  if request.page_type == 'index'
    case template.suffix
      when 'launch'
        assign title = 'U.S. launch coming soon | inchy'
        assign description = 'Register for INCHY U.S. launch emails and hear when our sacha inchi powder is available to order.'
        assign page_url = request.origin | append: routes.root_url | append: '?view=launch'
        unless settings.inchy_prelaunch
          assign title = 'Explore INCHY | inchy'
          assign description = 'Explore INCHY sacha inchi powder and find current product availability.'
        endunless
      when 'research'
        assign title = 'Satiety, GLP-1 and the research | inchy'
        assign description = 'Explore the laboratory research into sacha inchi peptides, read the original study and understand what the findings do and do not establish.'
        assign page_url = request.origin | append: routes.root_url | append: '?view=research'
      when 'how-to-use'
        assign title = 'How to use | inchy'
        assign description = 'How to include INCHY sacha inchi powder powder in your routine, with mixing guidance and product information.'
        assign page_url = request.origin | append: routes.root_url | append: '?view=how-to-use'
      when 'support'
        assign title = 'Contact and support | inchy'
        assign description = 'Contact INCHY about product questions, delivery, returns or an existing order.'
        assign page_url = request.origin | append: routes.root_url | append: '?view=support'
      else
        assign title = 'INCHY | Nutrition. With satiety in mind.'
        assign description = 'Protein and fibre from one remarkable seed. Discover INCHY sacha inchi powder, developed in Colombia with satiety in mind. No added flavours. A distinctive taste of its own.'
    endcase
  endif
-%}
<title>{{ title | escape }}{% if current_tags %} — {{ current_tags | join: ', ' | escape }}{% endif %}{% if current_page != 1 %} — Page {{ current_page }}{% endif %}{% assign title_lower = title | downcase %}{% assign site_name_lower = site_name | downcase %}{% unless title_lower contains site_name_lower %} — {{ site_name | escape }}{% endunless %}</title>
<link rel="canonical" href="{{ page_url | escape }}">
{% if description != blank %}<meta name="description" content="{{ description | escape }}">{% endif %}
{% render 'meta-tags', seo_title: title, seo_description: description, seo_url: page_url, seo_site_name: site_name %}
