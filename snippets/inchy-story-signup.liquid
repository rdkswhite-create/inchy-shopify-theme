{%- assign story_form_id = 'StoryAccess-' | append: instance_id -%}
{%- assign story_form_return = routes.root_url | append: '#' | append: story_form_id -%}
{% form 'customer', id: story_form_id, class: 'story-form', return_to: story_form_return %}
  <input type="hidden" name="contact[tags]" value="newsletter,inchy-us-launch,inchy-industry-story">
  {% if form.errors %}<div class="story-form__status story-form__status--error" id="{{ story_form_id }}-error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
  {% if form.posted_successfully? %}<p class="story-form__status" role="status">Thanks for joining. If you receive a confirmation email, follow its link to finish subscribing.</p>{% endif %}
  <label class="story-sr" for="{{ story_form_id }}-email">Email address</label>
  <div class="story-form__fields">
    <input type="email" id="{{ story_form_id }}-email" name="contact[email]" value="{{ form.email | escape }}" placeholder="Email address" autocomplete="email" autocapitalize="off" autocorrect="off" required aria-describedby="{{ story_form_id }}-consent{% if form.errors %} {{ story_form_id }}-error{% endif %}" {% if form.errors %}aria-invalid="true"{% endif %}>
    <button class="story-button" type="submit" name="commit">Get first access</button>
  </div>
  <p class="story-form__consent" id="{{ story_form_id }}-consent">INCHY launch emails. Unsubscribe at any time.{% if shop.privacy_policy != blank %} <a href="{{ shop.privacy_policy.url }}">Privacy policy</a>.{% endif %}</p>
{% endform %}
